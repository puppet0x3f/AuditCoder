# Copy to .env and fill in a provider you can access.
# All runners accept API_KEY; legacy *_API variables are also accepted.
AUDITCODER_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional Qwen configuration (set AUDITCODER_LLM_PROVIDER=qwen).
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional GLM configuration for the AuditCoder APPS/ClassEval runners.
GLM_API_KEY=
GLM_MODEL=glm-4.7
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
