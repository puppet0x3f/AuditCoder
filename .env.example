# Select the provider used by auditcoder/common/llm.py: qwen or glm.
AUDITCODER_LLM_PROVIDER=qwen

# Generated code runs on the host unless the container backend is selected.
# Build containers/eval first; never use the host backend for untrusted code.
AUDITCODER_EXECUTION_BACKEND=host
AUDITCODER_CONTAINER_RUNTIME=docker
AUDITCODER_CONTAINER_IMAGE=auditcoder-eval:aaai27
AUDITCODER_CONTAINER_CPUS=2
AUDITCODER_CONTAINER_PIDS_LIMIT=256
AUDITCODER_CONTAINER_TMPFS_MB=256

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
QWEN_MODEL=qwen-plus
QWEN_MAX_TOKENS=

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.7
GLM_MAX_TOKENS=

# Used by the DeepSeek APPS baselines and ablations.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=
